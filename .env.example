# =============================================================================
# CareerPilot AI — Environment Variables
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored, so your secrets never get committed.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase — CLIENT SDK (safe to expose to the browser)
# NEXT_PUBLIC_ vars are bundled into client JS. Firebase web config is designed
# to be public; security is enforced by Firestore/Storage rules, not by hiding
# these values. Get them from: Firebase Console > Project settings > Your apps.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# -----------------------------------------------------------------------------
# Firebase — ADMIN SDK (SERVER ONLY — never expose these)
# Used in Server Actions to verify sessions and write trusted data.
# Get them from: Firebase Console > Project settings > Service accounts >
# Generate new private key (downloads a JSON file with these three fields).
# NOTE: paste the private key on ONE line, keeping the literal \n sequences.
# -----------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# AI — Google Gemini (SERVER ONLY)
# The Vercel AI SDK's @ai-sdk/google provider reads this exact variable name.
# Get a free key from: https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# Vercel Blob — file storage (SERVER ONLY)
# Read-write credential for the WHOLE store: as dangerous as the admin key.
# Create a Blob store at vercel.com > Add New > Store > Blob (set it Private).
# In production, connecting the store to the project injects this automatically.
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"
