rules_version = '2';

// Cloud Storage security rules — access control for the actual PDF files.
// Mirrors the Firestore rules: a user only ever touches files under their uid.
// Here we ALSO validate the upload itself (type + size) server-side, so even a
// tampered client can't sneak in a 4 GB file or a non-PDF.
//
// Deploy: `firebase deploy --only storage`
// (or paste into Firebase Console → Storage → Rules → Publish)
//
// Week 3 needs no change here: the AI analyser reads text out of Firestore and
// never touches Storage. Resumes are still the only files we hold.

service firebase.storage {
  match /b/{bucket}/o {

    // Path shape: users/{uid}/resumes/{fileName}
    match /users/{userId}/resumes/{fileName} {

      // Only the owner can read (this is what makes the download URL private).
      allow read: if request.auth != null && request.auth.uid == userId;

      // Creating/overwriting: owner only, PDF only, 5 MB max.
      // request.resource is the INCOMING file — we inspect it before allowing.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size <= 5 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';

      // Owner can delete their own files.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
